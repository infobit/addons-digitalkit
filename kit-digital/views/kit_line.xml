<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="kit_line_view_form" model="ir.ui.view">
            <field name="name">kit line form</field>
            <field name="model">kit.line</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="date"/>
                                <field name="partner_id"/>
                                <field name="description"/>
                                <field name="user_id"/>
                                <field name="price"/>
                                <field name="qty_invoice"/>
                                <field name="discount"/>
                                <field name="amount"/>
                                <field name="working_hours"/>
                                <field name="lock"/>
                                <field name="internal"/>
                           </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="kit_line_view_search" model="ir.ui.view">
            <field name="name">kit.line.search</field>
            <field name="model">kit.line</field>
            <field name="arch" type="xml">
                <search>
                    <field name="partner_id"/>
                    <field name="user_id"/>
                    <field name="date"/>
                    <field name="name"/>
                    <field name="internal"/>
                    <filter string="Internas" name="internal_lines" domain="[('internal', '=', True)]" />
                    <filter string="Liquidadas" name="lock_lines" domain="[('lock', '=', True)]" />
                    <filter string="No liquidadas" name="noliquidadas_lines" domain="[('lock','=',False)]" />
                    <filter name="today" string="Hoy" domain="[('date', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00')),('date', '&lt;=',datetime.datetime.now().strftime('%Y-%m-%d 23:23:59'))]"/>
                    <filter name="MyLines" string="Mis lineas" domain="[('user_id', '=', uid)]"/>
                    <filter name="MyLinesToday" string="Mis lineas hoy" domain="[('user_id', '=', uid), ('date', '&gt;=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00')),('date', '&lt;=',datetime.datetime.now().strftime('%Y-%m-%d 23:23:59'))]"/>
                    <filter string="Mes Actual" name="current_month" domain="[('date','&lt;',(context_today()+relativedelta(months=1)).strftime('%%Y-%%m-01')), ('date','&gt;=',time.strftime('%%Y-%%m-01'))]"/>
                    <filter string="Mes anterior" name="prev_month" domain="[('date','&gt;=',(context_today()-relativedelta(months=1)).strftime('%%Y-%%m-01')),('date','&lt;',time.strftime('%%Y-%%m-01'))]"/>
                    <filter name="group_by_user" string="Empleado" domain="[]" context="{'group_by':'user_id'}"/>
                    <filter name="group_by_partner" string="Cliente" domain="[]" context="{'group_by':'partner_id'}"/>
                    <filter name="group_by_date" string="Mes" domain="[]" context="{'group_by':'date:month'}"/>
                    <filter string="Semana" name="groupby_week" domain="[]" context="{'group_by':'date:week'}" help="Semana"/>
                    <filter string="Día" name="groupby_day" domain="[]" context="{'group_by':'date:day'}" help="Dia"/>
                </search>
            </field>
        </record>

        <record id="kit_line_view_tree" model="ir.ui.view">
            <field name="name">kit line tree view</field>
            <field name="model">kit.line</field>
            <field name="arch" type="xml">
                <tree editable="bottom" decoration-danger="internal == True">
                    <field name="date" attrs="{'readonly':['|',('lock','=',True)]}" />
                    <field name="user_id" attrs="{'readonly':['|',('lock','=',True)]}" />
                    <field name="partner_id" attrs="{'readonly':['|',('lock','=',True)]}" />
                    <field name="product_id" attrs="{'readonly':['|',('lock','=',True)]}" />
                    <field name="name" attrs="{'readonly':['|',('lock','=',True)]}" />
                    <field name="description" attrs="{'readonly':['|',('lock','=',True)]}" />
                    <field name="qty_invoice" sum="Cant.Factura" widget="float" attrs="{'readonly':['|',('lock','=',True)]}" />
                    <field name="working_hours" sum="Horas trabajadas" widget="float_time" attrs="{'readonly':['|',('lock','=',True)]}" />
                    <field name="price" widget="float" attrs="{'readonly':['|',('lock','=',True)]}" />
                    <field name="discount"/>
                    <field name="amount" widget="float" sum="Total" attrs="{'readonly':['|',('lock','=',True)]}" />
                    <field name="lock"/>
                    <field name="internal"/>
                </tree>
            </field>
        </record>

        <record id="kit_line_action" model="ir.actions.act_window">
            <field name="name">Kit Lines</field>
            <field name="res_model">kit.line</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p>
                    No Kit line found
                </p>
            </field>
        </record>
        <menuitem name="Kit Lineas trabajos" id="menu_kit_line" parent="menu_action_digital_kit" action="kit_line_action"/>
        <menuitem name="Lineas de trabajo" id="menu_kit_linep" parent="menu_kd" action="kit_line_action"/>
    </data>
</odoo>
