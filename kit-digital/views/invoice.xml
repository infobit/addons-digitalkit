<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <record id="invoice_kitdigital_form" model="ir.ui.view">
            <field name="name">account.invoice.kitdigital.form</field>
            <field name="model">account.invoice</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="account.invoice_form" />
            <field name="arch" type="xml">
                <field name="amount_total" position="after">
                  <field name='solicitado'/>
                  <field name='pagado'/>
                </field>
             </field>
        </record>
        
        <record id="invoice_kitdigital_tree" model="ir.ui.view">
            <field name="name">account.invoice.kitdigital.tree</field>
            <field name="model">account.invoice</field>
            <field name="type">tree</field>
            <field name="inherit_id" ref="account.invoice_tree" />
            <field name="arch" type="xml">
                <field name="amount_total_signed" position="before">
                    <field name="solicitado" sum="Solicitado"/>
                    <field name="pagado" sum="Pagado"/>
                </field>
             </field>
        </record>

        <record id="action_account_invoice_kitdigital" model="ir.actions.act_window">
            <field name="name">Facturas kit digital</field>
            <field name="res_model">account.invoice</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="invoice_kitdigital_tree"/>
            <field name="view_mode">tree,kanban,form,pivot,graph</field>
            <!--<field name="search_view_id" ref="view_sales_order_line_ecoembes_filter"/>-->
            <!--<field name="context">{'search_default_product_id': [active_id], 'default_product_id': active_id}</field>-->
            <field name="domain">[('journal_id', '=', 19)]</field>
        </record>

        <menuitem name="Facturas kit digital" parent="kit-digital.menu_kd" id="menu_kitdigital_invoices"/>
        <menuitem name="Facturas" id="menu_kit_invoices" parent="menu_kitdigital_invoices" action="action_account_invoice_kitdigital"/>
    </data>
</openerp>
