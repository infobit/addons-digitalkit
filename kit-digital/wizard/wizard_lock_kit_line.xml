        <record id="view_wizard_lock_kit_line" model="ir.ui.view">
            <field name="name">Liquidar lineas</field>
            <field name="model">wizard.lock.kit.line</field>
            <field name="arch" type="xml">
                <form string="Liquidar">
                    <footer>
                        <button name="lock" string="Liquidar" type="object" class="oe_highlight"/>
